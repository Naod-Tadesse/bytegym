# Copy to .env and adjust as needed.

# --- local database only ---
# These drive `docker-compose.yml`, which exists so `nx run @org/backend:db-up`
# has something to talk to. Deployment does not use them at all: there, Postgres
# is a Coolify-managed service and only DATABASE_URL matters.
POSTGRES_USER=bytegym
POSTGRES_PASSWORD=bytegym
POSTGRES_DB=bytegym
POSTGRES_PORT=5432

DATABASE_URL=postgresql://bytegym:bytegym@localhost:5432/bytegym

PORT=3000

# --- auth ---
# generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRATION=7d

# --- seed admin ---
ADMIN_PHONE=0911000000
ADMIN_PASSWORD=Admin@123

# --- cors / frontend ---
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
VITE_BASE_URL=http://localhost:3000

# --- sms ---
# Unset means nothing is ever sent: messages go to the log instead. That is the
# safe default, because an SMS costs money, reaches a real person and cannot be
# recalled — a staging box on a copy of production must not text real members.
#
# Setting it is the whole switch. There is no recipient filter behind it: with a
# provider configured, every member the gym sends to is texted for real.
# SMS_PROVIDER=smsethiopia
# SMS_API_KEY=
# SMS_BASE_URL=https://smsethiopia.et

# --- deployment (docker-compose.vps.yml) ---
#
# Set these as Coolify Shared Variables at project scope, not in a file: one
# edit then covers the migrator, the API and the SPA build.
#
# THE WHOLE LIST. Nothing else is read in production:
#
#   required   DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET,
#              CORS_ORIGINS, VITE_BASE_URL, ADMIN_PHONE, ADMIN_PASSWORD
#   optional   PORT (3000), JWT_EXPIRATION (15m), JWT_REFRESH_EXPIRATION (7d),
#              SWAGGER_ENABLED (false), SMS_PROVIDER, SMS_API_KEY,
#              SMS_BASE_URL, DOCKER_REGISTRY, IMAGE_TAG
#
# POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB are NOT among them. They
# only ever configured the local `docker-compose.yml` container; the deployed
# stack has no database of its own, and the application reads DATABASE_URL and
# nothing else to reach one. Setting them in Coolify is harmless but does
# nothing — delete them to avoid implying the credentials live in two places.
#
# DATABASE_URL points at the COOLIFY-MANAGED Postgres service — that service's
# name on the shared network, never `localhost` and never a container this repo
# defines. The deploy stack has no database of its own, so redeploying it (or
# deleting it) cannot touch the data:
#   postgresql://<user>:<password>@<coolify-postgres-service>:5432/<db>
# The service needs "Connect To Predefined Network" enabled for that hostname to
# resolve; if it sits on its own network instead, add that network to
# docker-compose.vps.yml — there is a comment at the bottom showing where.
#
# CORS_ORIGINS is the browser's origin for the SPA, and also gates the
# WebSocket handshake — a missing origin breaks live updates while REST keeps
# working, which is a confusing way to find out.
# VITE_BASE_URL is compiled into the SPA at build time, so changing it needs a
# rebuild, not a restart. It must be an address a browser can reach.
#
# WEB_PORT is unused under Coolify: the SPA only exposes port 80 to the proxy,
# which terminates TLS and routes the domain. It matters again only if you swap
# that `expose:` back to a published `ports:` on a plain VPS.
# WEB_PORT=8080
# DOCKER_REGISTRY=
# IMAGE_TAG=latest
