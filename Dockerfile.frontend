# The SPA: built with Vite, served by nginx as static files.
FROM node:24-slim AS builder

WORKDIR /app

COPY . .

RUN npm ci
RUN npx nx sync

# Baked in at BUILD time, not runtime — Vite substitutes it into the bundle, so
# it cannot be changed by an environment variable on the running container.
# Point it at the API's public origin; the browser calls that directly, and the
# socket connects to it too, so it must be an address a browser can reach, never
# a container hostname.
ARG VITE_BASE_URL
ENV VITE_BASE_URL=$VITE_BASE_URL

RUN npx nx build @org/frontend --configuration=production


FROM nginx:1.27-alpine AS runtime

COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
